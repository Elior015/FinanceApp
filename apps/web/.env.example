# Public Supabase credentials — safe to expose to the browser.
# Fill these in from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The public URL of this web app. Used for password-reset and other
# email links. On Vercel this should match your production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
