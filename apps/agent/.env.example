# SECRET — the service-role key bypasses RLS entirely. This file must
# only ever live on the home box, never on Vercel or in the web app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides — see src/crypto/masterKey.ts for defaults.
# AGENT_DATA_DIR=/home/agent/.household-finance-agent

# Optional ntfy.sh topic for sync-failure / anomaly push notifications.
# NTFY_TOPIC=your-private-topic
