    "dev:web": "pnpm --filter web dev",
    "dev:agent": "pnpm --filter agent dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "typescript-eslint": "^8.19.1"
  }
